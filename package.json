{
  "name": "iobroker.apple",
  "version": "0.2.0",
  "description": "Discover and control Apple media devices on the local network",
  "author": {
    "name": "C@ptain Ch@os",
    "email": "223081183+Musashi1965@users.noreply.github.com"
  },
  "contributors": [],
  "homepage": "https://github.com/Musashi1965/ioBroker.apple",
  "license": "MIT",
  "keywords": [
    "ioBroker",
    "apple",
    "apple tv",
    "homepod",
    "airplay"
  ],
  "repository": {
    "type": "git",
    "url": "git@github.com:Musashi1965/ioBroker.apple.git"
  },
  "engines": {
    "node": ">= 22"
  },
  "dependencies": {
    "@basmilius/apple-common": "0.13.4",
    "@basmilius/apple-sdk": "0.13.4",
    "@iobroker/adapter-core": "^3.4.3"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@alcalzone/release-script-plugin-manual-review": "^5.2.0",
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/gui-components": "10.0.5",
    "@iobroker/json-config": "9.0.8",
    "@iobroker/testing": "^5.3.0",
    "@module-federation/runtime": "2.8.2",
    "@module-federation/vite": "1.19.1",
    "@mui/icons-material": "9.2.0",
    "@mui/material": "9.2.0",
    "@tsconfig/node22": "^22.0.6",
    "@types/iobroker": "npm:@iobroker/types@^7.2.2",
    "@types/node": "^22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "nyc": "^18.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rimraf": "^6.1.3",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3",
    "vite": "8.1.5",
    "vite-plugin-commonjs": "0.10.4"
  },
  "main": "build/main.js",
  "files": [
    "admin{,/!(src)/**}/!(tsconfig|tsconfig.*|.eslintrc).{json,json5}",
    "!admin/custom/mf-stats.json",
    "admin{,/!(src)/**}/*.{html,css,png,svg,jpg,js}",
    "build/",
    "www/",
    "io-package.json",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "prebuild": "rimraf build && npm run build:admin",
    "build": "build-adapter ts",
    "build:admin": "cd src-admin && vite build --config vite.config.ts",
    "watch": "build-adapter ts --watch",
    "prebuild:ts": "rimraf build",
    "build:ts": "build-adapter ts",
    "watch:ts": "build-adapter ts --watch",
    "test:ts": "mocha --config test/mocharc.custom.json \"src/**/*.test.ts\"",
    "test:unit": "npm run test:ts",
    "test:package": "mocha test/package --exit",
    "test:integration": "mocha test/integration --exit",
    "test": "npm run test:ts && npm run test:package",
    "poc:build": "rimraf .poc-build && tsc -p tsconfig.poc.json",
    "poc:test": "npm run poc:build && node --test .poc-build/*.test.cjs",
    "poc:discovery": "npm run poc:build && node .poc-build/runAppleSdkDiscovery.cjs",
    "poc:discovery:low-level": "npm run poc:build && node .poc-build/runAppleLowLevelDiscovery.cjs",
    "poc:pair": "npm run poc:build && node .poc-build/pairAppleTv.cjs pair",
    "poc:verify-pairing": "npm run poc:build && node .poc-build/pairAppleTv.cjs verify",
    "poc:probe-control": "npm run poc:build && node .poc-build/probeAppleTvControl.cjs",
    "poc:monitor-events": "npm run poc:build && node .poc-build/monitorAppleTvEvents.cjs",
    "check": "tsc --noEmit && npm run check:admin",
    "check:admin": "tsc -p src-admin/tsconfig.json",
    "check:quick": "npm run lint && npm run check && npm run test:ts",
    "check:full": "npm run check:quick && npm run test:package && npm run build && npm run test:integration",
    "coverage": "nyc npm run test:ts",
    "lint": "eslint -c eslint.config.mjs .",
    "translate": "translate-adapter",
    "release": "release-script"
  },
  "nyc": {
    "include": [
      "src/**/*.ts"
    ],
    "exclude": [
      "src/**/*.test.ts"
    ],
    "extension": [
      ".ts"
    ],
    "require": [
      "ts-node/register"
    ],
    "reporter": [
      "text-summary",
      "html"
    ],
    "sourceMap": true,
    "instrument": true
  },
  "bugs": {
    "url": "https://github.com/Musashi1965/ioBroker.apple/issues"
  },
  "readmeFilename": "README.md"
}
